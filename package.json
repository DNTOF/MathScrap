{
  "name": "mathscrap",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "test:pack": "tsx scripts/pack-smoke.ts && tsx scripts/i18n-smoke.ts",
    "test:i18n": "tsx scripts/i18n-smoke.ts",
    "pack:web": "tsc -b && vite build && node scripts/verify-packaged-dist.mjs",
    "pack:desktop": "tauri build",
    "pack:windows": "bash scripts/package-windows.sh",
    "pack:android": "bash scripts/package-android.sh",
    "pack:ios": "bash scripts/package-ios.sh",
    "tauri": "tauri",
    "build:wasm": "cd crates/mathcore && wasm-pack build --target web --release --out-dir ../../src/wasm/pkg --out-name mathcore && rm -f ../../src/wasm/pkg/.gitignore",
    "test:rust": "cd crates/mathcore && cargo test",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:ai": "tsx scripts/ai-mcp-smoke.ts",
    "smoke:ocr": "tsx scripts/ocr-smoke.ts",
    "ocr:live": "tsx scripts/ocr-live.ts",
    "mcp": "tsx mcp/server.ts",
    "smoke:ink": "tsx scripts/ink-geom-smoke.ts",
    "e2e": "tsx scripts/e2e-plots.ts",
    "e2e:sheet": "tsx scripts/e2e-sheet.ts",
    "e2e:ink": "tsx scripts/e2e-ink.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.65.0",
    "onnxruntime-web": "^1.22.0",
    "onnxruntime-web-nosimd": "npm:onnxruntime-web@1.18.0",
    "perfect-freehand": "^1.2.3",
    "plotly.js-dist-min": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.2",
    "@types/plotly.js-dist-min": "^2.3.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "license": "Apache-2.0",
  "description": "Kraft-paper math scrapbook: Freeform-like sheet, shared plot, geometry inference (Rust/WASM)."
}
